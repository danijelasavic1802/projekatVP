<?xml version="1.0" encoding="utf-8" ?>
<configuration>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>

	<appSettings>
		<add key="CsvPath" value="Data\dataset.csv"/>
		<add key="RejectLogPath" value="rejects_client.csv"/>
	</appSettings>

	<system.serviceModel>
		<client>
			<endpoint
			  name="SensorServiceEndpoint"
			  address="net.tcp://localhost:9000/SensorService"
			  binding="netTcpBinding"
			  bindingConfiguration="tcpBinding"
			  contract="Common.ISensorService" />
		</client>

		<bindings>
			<netTcpBinding>
				<binding name="tcpBinding"
						 transferMode="Streamed"
						 maxReceivedMessageSize="10485760"
						 openTimeout="00:01:00"
						 closeTimeout="00:01:00"
						 sendTimeout="00:05:00"
						 receiveTimeout="00:10:00" />
			</netTcpBinding>
		</bindings>
	</system.serviceModel>

</configuration>