<?xml version="1.0" encoding="utf-8" ?>
<configuration>

	<appSettings>
		<add key="L_threshold" value="50"/>
		<add key="RH_threshold" value="10"/>
		<add key="AQ_threshold" value="20"/>
		<add key="AverageDeviationPercent" value="25"/>
		<add key="ServerOutputFolder" value="ServerData"/>
	</appSettings>

	<system.serviceModel>
		<services>
			<service name="Server.SensorService">
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:9000/SensorService"/>
					</baseAddresses>
				</host>

				<endpoint
				  address=""
				  binding="netTcpBinding"
				  bindingConfiguration="tcpBinding"
				  contract="Common.ISensorService" />

			</service>
		</services>

		<bindings>
			<netTcpBinding>
				<binding name="tcpBinding"
						 transferMode="Streamed"
						 maxReceivedMessageSize="10485760"
						 openTimeout="00:01:00"
						 closeTimeout="00:01:00"
						 sendTimeout="00:05:00"
						 receiveTimeout="00:10:00">
				</binding>
			</netTcpBinding>
		</bindings>
	</system.serviceModel>

</configuration>